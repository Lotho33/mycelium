# Settings for docker-compose.yml (build from source). Copy to ".env" next to
# it; ".env" is gitignored. Everything here is optional.

# Optional VPN egress: a SOCKS5/HTTP proxy URL (e.g. socks5://host.docker.internal:1080).
VPN_PROXY_URL=

# Optional browser service for plugins that need one (mycelium.browser.*).
MYCELIUM_BROWSER_URL=
MYCELIUM_BROWSER_API_KEY=

# Bridge mode: the address clients use to reach this server (IP or host[:port]).
MYCELIUM_SERVER_HOST=

TZ=UTC
