# Runtime config & data
data/config.json
data/logs/
data/pileus-web/
data/pileus-web-tv/
data/imgcache/
data/*.db
data/*.db-shm
data/*.db-wal

# Per-plugin runtime data (caches, disk fallbacks) — regenerated at runtime,
# never source, never distributed with a plugin.
data/plugins/
plugins/*/*_cache.json
plugins/*/*_index.json

# mycelium ships no plugins of its own. plugins/ is where an operator drops
# their own (or a released .zip is extracted); it's local, never committed.
# `git add -f plugins/<name>` if a first-party plugin is ever bundled.
/plugins/

# Compiled binaries
*.exe
/server
/mycelium
cmd/server/server
cmd/server/mycelium

# Build/dev artifacts
tmp/
*.log

# OS / editor
.DS_Store
*.swp

# Claude Code local state — settings, worktrees, scheduler locks. All
# machine-specific (absolute paths, per-session state); never shared config.
.claude/

# Secrets
.env

# WireGuard configs an operator drags into the dashboard (real private
# keys, plaintext .conf — see internal/managers/wireproxy.go). Runtime
# state, never source; never committed.
data/wireproxy/

# Runtime state of the server and of any companion service (sessions,
# credentials, caches; may contain root-owned 0600 files that make
# `git add .` fail with "Permesso negato") — never source, never committed.
/data/

# Local-only compose overlays (private companion services, per-host tweaks)
# — never distributed with the public repo.
docker-compose.private*.yml
docker-compose.appliance*.yml

# Operator-only runbooks (host provisioning notes) — kept outside the public repo.
docs/deploy-appliance-node.md
