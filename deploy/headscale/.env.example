# Domain (A/AAAA record) pointing at this VPS's public IP — required for
# Caddy's automatic Let's Encrypt certificate and must match server_url in
# config.yaml.
HEADSCALE_DOMAIN=mesh.example.com

# Contact email for Let's Encrypt expiry/problem notices.
ACME_EMAIL=you@example.com

# Pin to whatever version you've actually tested; check
# https://github.com/juanfont/headscale/releases before first deploy.
HEADSCALE_TAG=0.23.0
