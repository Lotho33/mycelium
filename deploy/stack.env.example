# Self-hosted stack settings. Copy to ".env" in the REPO ROOT (next to
# docker-compose.prod.yml):   cp deploy/stack.env.example .env
# ".env" is gitignored. See docs/deploy-selfhosted.md.

# mycelium + redis + watchtower, plus cobweb (browser/fetch sidecar).
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.cobweb.yml

# No VPN egress in this stack (every current plugin egresses directly).
# Leave empty; point it at a SOCKS5 proxy only if you run one.
VPN_PROXY_URL=

# Prefer IPv6 towards upstream CDNs (1) — only useful when the host's IPv4 is
# CGNAT'd / has a poor reputation and it has a clean public IPv6.
MYCELIUM_EGRESS_IPV6=0

# Watchtower mounts this file (registry credentials). All images in this
# stack are public, but the file must EXIST as a file before the first `up`
# (otherwise Docker creates a directory there and Watchtower breaks):
#   mkdir -p ~/.docker && [ -f ~/.docker/config.json ] || echo '{}' > ~/.docker/config.json
# Absolute path of that file:
DOCKER_CONFIG_JSON=/root/.docker/config.json

# Optional: same value as [server].api_key in deploy/cobweb/cobweb.toml.
#COBWEB_API_KEY=

# Pin versions (then remove the watchtower label from that service):
#MYCELIUM_TAG=latest
#COBWEB_TAG=latest
