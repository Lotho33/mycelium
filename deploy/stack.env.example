# Server stack settings. Copy to ".env" in the repo root (next to
# docker-compose.prod.yml):   cp deploy/stack.env.example .env
# ".env" is gitignored. See docs/deploy-selfhosted.md.

COMPOSE_FILE=docker-compose.prod.yml

# Registry/tag of the mycelium image (pin a version, then remove the
# Watchtower label from the service).
#MYCELIUM_IMAGE=ghcr.io/lotho33/mycelium
#MYCELIUM_TAG=latest

# Optional VPN egress: a SOCKS5/HTTP proxy URL. Empty = none.
VPN_PROXY_URL=

# Optional browser service for plugins that need one (mycelium.browser.*).
#MYCELIUM_BROWSER_URL=http://127.0.0.1:8191
#MYCELIUM_BROWSER_API_KEY=

# Prefer IPv6 towards upstream hosts (1) — only when the host's IPv4 is
# shared (CGNAT) and it has a public IPv6.
MYCELIUM_EGRESS_IPV6=0

TZ=UTC

# Watchtower mounts this file (registry credentials). It must EXIST as a file
# before the first `up` (otherwise Docker creates a directory there):
#   mkdir -p ~/.docker && [ -f ~/.docker/config.json ] || echo '{}' > ~/.docker/config.json
DOCKER_CONFIG_JSON=/root/.docker/config.json
